{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./node_modules/.cache/tsc/preload",
		"tsBuildInfoFile": "./node_modules/.cache/tsc/preload.tsbuildinfo"
	},
	"include": ["src/preload.ts", "src/annotate-preload.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/renderer/test/**"],
	"references": [{ "path": "./tsconfig.shared.json" }, { "path": "./tsconfig.main.json" }]
}
