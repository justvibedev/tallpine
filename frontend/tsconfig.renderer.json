{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./node_modules/.cache/tsc/renderer",
		"tsBuildInfoFile": "./node_modules/.cache/tsc/renderer.tsbuildinfo"
	},
	"include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/renderer/**/*.json", "../packages/product-ui/src/**/*.ts", "../packages/product-ui/src/**/*.tsx"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test.*.ts", "src/**/*.test.*.tsx", "src/renderer/test/**", "../packages/product-ui/src/**/*.test.ts", "../packages/product-ui/src/**/*.test.tsx"],
	"references": [{ "path": "./tsconfig.shared.json" }, { "path": "./tsconfig.main.json" }, { "path": "./tsconfig.preload.json" }]
}
