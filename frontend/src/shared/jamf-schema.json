					"type": "boolean"
				},
				"app.providerEventRetentionDays": {
					"description": "Days provider events of a terminated session are kept while compaction is on.",
					"maximum": 3650,
					"minimum": 1,
					"title": "app.providerEventRetentionDays",
					"type": "integer"
				},
