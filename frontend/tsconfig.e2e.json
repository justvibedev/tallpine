{
	// Typechecks the Playwright e2e suite, which the main tsconfig does not
	// include. Playwright transpiles specs without typechecking, so without this
	// project the `satisfies TallpineBridge` guard in e2e/support/fake-bridge.ts (the
	// preload-drift tripwire) would never actually run. Wired into the
	// renderer-smoke CI job via `npm run typecheck:e2e`.
	"extends": "./tsconfig.base.json",
	// A plain program (not a composite project): it checks the app sources the
	// specs import directly, so it needs no `tsc -b` outputs.
	"compilerOptions": {
		"composite": false,
		"emitDeclarationOnly": false,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsc/e2e.tsbuildinfo"
	},
	"include": ["e2e/**/*.ts", "e2e/**/*.tsx", "playwright.config.ts"]
}
