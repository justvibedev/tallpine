<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sample Configuration Profile that turns on the Tallpine agent policy.
  Nothing is enforced unless a profile like this is installed (or a user opts in
  in Settings). Delete the rules you do not want; every rule you list becomes
  locked in the app. Replace the two PayloadUUID values with fresh UUIDs
  (uuidgen) and the identifier/organization with your own before uploading it to
  your MDM. See docs/agent-policy.md, "Enabling policies for your organization".
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>ee.justdev.tallpine</string>
			<key>PayloadIdentifier</key>
			<string>com.example.tallpine.agent-policy.settings</string>
			<key>PayloadUUID</key>
			<string>00000000-0000-4000-8000-000000000001</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>Tallpine agent policy</string>

			<key>schemaVersion</key>
			<integer>2</integer>
			<key>rules</key>
			<dict>
				<!-- Agents get GitHub tokens from the daemon on request, never in their environment. -->
				<key>githubCreds</key>
				<dict>
					<key>mode</key>
					<string>helper</string>
				</dict>
				<!-- Agents start with a curated environment, not the daemon's whole one. -->
				<key>envFilter</key>
				<dict>
					<key>mode</key>
					<string>allowlist</string>
					<key>passthrough</key>
					<array>
						<string>CORP_PROXY_*</string>
					</array>
				</dict>
				<!-- No bypass or full-access permission modes. -->
				<key>permissionCap</key>
				<dict>
					<key>max</key>
					<string>auto</string>
				</dict>
			</dict>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>Tallpine agent policy</string>
	<key>PayloadIdentifier</key>
	<string>com.example.tallpine.agent-policy</string>
	<key>PayloadOrganization</key>
	<string>Example Corp</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>00000000-0000-4000-8000-000000000002</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
