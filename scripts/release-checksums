#!/usr/bin/env bash
# Write SHA256SUMS for every release asset in a directory.
#
#   scripts/release-checksums <assets-dir>
#
# Run this on the final assets right before publishing the release and upload
# SHA256SUMS alongside them. `tallpine start` refuses to install a download whose
# SHA-256 is not listed in the release's SHA256SUMS.
set -euo pipefail

dir="${1:-}"
[[ -d "${dir}" ]] || { echo "usage: release-checksums <assets-dir>" >&2; exit 2; }

cd "${dir}"
rm -f SHA256SUMS
files=()
while IFS= read -r f; do files+=("${f#./}"); done < <(find . -maxdepth 1 -type f ! -name 'SHA256SUMS' | LC_ALL=C sort)
[[ ${#files[@]} -gt 0 ]] || { echo "release-checksums: no assets in ${dir}" >&2; exit 1; }

if command -v sha256sum >/dev/null 2>&1; then
  sha256sum "${files[@]}" > SHA256SUMS
else
  shasum -a 256 "${files[@]}" > SHA256SUMS
fi
echo "wrote ${dir}/SHA256SUMS (${#files[@]} assets)"
