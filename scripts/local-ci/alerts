#!/usr/bin/env bash
# scripts/local-ci/alerts: prints the local-CI alerts not yet passed on, oldest first, and marks them done.
#
# B631: the local-CI loop and the detached release build run under launchd, outside Tallpine, so a
# signed daemon refuses their messages. They append alerts to <results>/alerts.tsv instead (see
# scripts/lib/notify.sh). A Tallpine automation runs this script on a schedule and its agent passes
# whatever it prints to the main-health orchestrator with its own scoped CLI.
#
#   scripts/local-ci/alerts            print new alerts ("<UTC time> <message>", one per line), then advance
#   scripts/local-ci/alerts --peek     print them without advancing
#   scripts/local-ci/alerts --target   print the main-health orchestrator's session id ($H/notify-target), if set
#
# The cursor is the byte offset already printed, in <results>/alerts.cursor, replaced whole. Only complete
# lines are printed, so an alert being appended waits for the next run. Every run without --peek rewrites
# the cursor, even with nothing new: its mtime is how tp_record_alert knows a reader is running. A file shorter than the cursor
# (truncated or replaced) is read from the start. TALLPINE_LOCAL_CI_DIR and OUT locate the files as in loop.sh.
#
# The automation, created by the owner (automations are theirs) in the desktop app or with:
#   tallpine automation create --project agent-orchestrator --name "Local CI alerts" --cron "*/30 * * * *" \
#     --prompt "Run scripts/local-ci/alerts. If it prints nothing, report done. Otherwise send its output to
#     the session printed by 'scripts/local-ci/alerts --target' with tallpine send, or, if that prints
#     nothing, put it in a tallpine report --needs-input note; then report done."
set -euo pipefail
H="${TALLPINE_LOCAL_CI_DIR:-$HOME/.tallpine/local-ci}"
OUT="${OUT:-$H/results}"
mode=print
case "${1:-}" in
"") ;;
--peek) mode=peek ;;
--target)
	head -n 1 "$H/notify-target" 2>/dev/null | tr -d '[:space:]' || true
	echo
	exit 0
	;;
-h | --help)
	awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
	exit 0
	;;
*)
	echo "alerts: unknown argument $1" >&2
	exit 2
	;;
esac
exec python3 -I -c '
import os, sys
alerts, cursor, mode = sys.argv[1:4]
try:
    data = open(alerts, "rb").read()
except FileNotFoundError:
    data = b""
try:
    start = int(open(cursor).read().strip() or 0)
except (FileNotFoundError, ValueError):
    start = 0
if start > len(data):
    start = 0
end = max(start, data.rfind(b"\n", start) + 1)
for line in data[start:end].decode("utf-8", "replace").splitlines():
    when, _, msg = line.partition("\t")
    print(when + " " + msg if msg else line)
sys.stdout.flush()
if mode == "print":  # also when nothing is new: the stamp tells tp_alert_reader_stale a reader runs
    os.makedirs(os.path.dirname(cursor), exist_ok=True)
    tmp = cursor + ".tmp"
    with open(tmp, "w") as f:
        f.write(str(end))
    os.replace(tmp, cursor)
' "$OUT/alerts.tsv" "$OUT/alerts.cursor" "$mode"
